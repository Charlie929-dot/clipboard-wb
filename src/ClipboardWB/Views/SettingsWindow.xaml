<Window x:Class="ClipboardWB.Views.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipboardWB 设置" Width="386" Height="404"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="20">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>

        <Border CornerRadius="18" Background="#66091018" Margin="0">
            <Border.Effect>
                <DropShadowEffect Color="#00060C" BlurRadius="26" ShadowDepth="8"
                                  Direction="270" Opacity="0.72" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="18" Background="{StaticResource GlassBackground}"
                BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource AccentGradient}" />

                <!-- title bar -->
                <Grid Grid.Row="1" Margin="18,14,14,6" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="设置" FontFamily="{StaticResource UiFont}" FontSize="16"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="ClipboardWB · 让复制粘贴更顺手" Margin="0,3,0,0"
                                   FontFamily="{StaticResource UiFont}" FontSize="10.5"
                                   Foreground="{StaticResource TextMuted}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="✕"
                            Click="Close_Click" VerticalAlignment="Top" />
                </Grid>

                <StackPanel Grid.Row="2" Margin="18,10,18,4">
                    <!-- max items -->
                    <TextBlock Text="历史容量" FontFamily="{StaticResource UiFont}" FontSize="12.5"
                               Foreground="{StaticResource TextPrimary}" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="MaxValue" DockPanel.Dock="Right" Text="40 条" Width="46"
                                   TextAlignment="Right" FontFamily="{StaticResource UiFont}" FontSize="11.5"
                                   Foreground="{StaticResource Accent2}" />
                        <Slider x:Name="MaxSlider" Minimum="10" Maximum="120" TickFrequency="5"
                                Value="40" IsSnapToTickEnabled="True" Margin="0,0,10,0"
                                ValueChanged="MaxSlider_ValueChanged" />
                    </DockPanel>
                    <TextBlock Text="超出后自动淘汰最旧的非置顶记录" Margin="0,2,0,0"
                               FontFamily="{StaticResource UiFont}" FontSize="10.5"
                               Foreground="{StaticResource TextMuted}" />

                    <Border Height="1" Background="{StaticResource GlassBorder}" Margin="0,16,0,14" />

                    <!-- autostart -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开机自动启动" FontFamily="{StaticResource UiFont}" FontSize="12.5"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="写入当前用户的启动项" Margin="0,3,0,0"
                                       FontFamily="{StaticResource UiFont}" FontSize="10.5"
                                       Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                        <CheckBox x:Name="AutoStartBox" Grid.Column="1" Style="{StaticResource Switch}"
                                  VerticalAlignment="Center" Click="AutoStart_Click" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource GlassBorder}" Margin="0,16,0,14" />

                    <!-- hotkey reference -->
                    <TextBlock Text="操作方式" FontFamily="{StaticResource UiFont}" FontSize="12.5"
                               Foreground="{StaticResource TextPrimary}" />
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ctrl + V" FontFamily="{StaticResource UiFont}"
                                   FontSize="11.5" Foreground="{StaticResource Accent}" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="唤出历史面板" Style="{StaticResource HintText}" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="1" Text="↑ / ↓" FontFamily="{StaticResource UiFont}"
                                   FontSize="11.5" Foreground="{StaticResource Accent}" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="在历史中移动选择" Style="{StaticResource HintText}" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="2" Text="V / Enter" FontFamily="{StaticResource UiFont}"
                                   FontSize="11.5" Foreground="{StaticResource Accent}" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="粘贴选中项（1-9 可直接跳转）" Style="{StaticResource HintText}" Margin="0,0,0,7" />
                        <TextBlock Grid.Row="3" Text="Esc" FontFamily="{StaticResource UiFont}"
                                   FontSize="11.5" Foreground="{StaticResource Accent}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="关闭面板，不影响原剪贴板" Style="{StaticResource HintText}" />
                    </Grid>
                </StackPanel>

                <!-- footer -->
                <Border Grid.Row="3" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,1,0,0"
                        Padding="16,11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="清空历史" Style="{StaticResource ActionButton}"
                                Foreground="#FF9AA6" Click="Clear_Click" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0,12,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource UiFont}" FontSize="10.5"
                                   Foreground="{StaticResource TextMuted}" />
                        <Button Grid.Column="2" Content="完成" Style="{StaticResource ActionButton}"
                                Background="{StaticResource Accent}" Click="Close_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
