<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The .NET 10 SDK in ../../.tools provides all targeting packs, so a plain
    `dotnet build` needs no network at all. RID-specific publishing additionally
    needs the win-x64 runtime/ILLink packs; they are fetched from nuget.org on
    the first publish and then served from the global package cache.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
